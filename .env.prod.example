# Production environment variables
# Copy this file to .env and fill in the actual values

# Database
DB_URL=jdbc:mysql://your-db-host:3306/slack_clone?useSSL=true
DB_USER=prod_user
DB_PASSWORD=change_me_strong_password

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379

# Kafka
KAFKA_SERVERS=your-kafka-broker-1:9092,your-kafka-broker-2:9092,your-kafka-broker-3:9092

# Application
SPRING_PROFILES_ACTIVE=prod

# Security
JWT_SECRET=change_me_very_long_random_secret_key_here

# Observability (Optional)
ELASTIC_APM_SERVER_URL=http://your-apm-server:8200
ELASTIC_APM_SECRET_TOKEN=your_secret_token
